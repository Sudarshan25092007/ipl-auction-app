# ==============================================================================
# IPL MOCK AUCTION PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Port the Express backend server listens on
PORT=3001

# URL of the Next.js frontend application (used for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Next.js Public API URL (frontend needs this to know where the backend is)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Database Connection (Supabase PostgreSQL Connection String)
# Example: postgresql://postgres:your-password@db.supabase.co:5432/postgres
DATABASE_URL=your-supabase-postgresql-connection-string

# JSON Web Token Secret (used for signing and verifying stateless session JWTs)
# Can be generated using: openssl rand -base64 32
JWT_SECRET=your-random-jwt-secret-string

# Redis Connection (used for live rooms and socket events)
# Example: rediss://default:your-password@your-upstash-redis.upstash.io:6379
REDIS_URL=your-redis-connection-string

# Google OAuth Credentials (for authentication dual login system)
# Retrieve these from Google Cloud Console -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
