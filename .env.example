# ─── Database (Supabase / PostgreSQL) ────────────────────────────────────────
# Connection string for the primary database.
# Supabase: Settings → Database → Connection string → URI
DATABASE_URL=postgresql://user:password@host:5432/ipl_auction

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
# Used for: distributed lock, auction hot state, rate limiting, timer deadline
# Upstash console: Database → REST API → REDIS_URL
REDIS_URL=redis://default:password@host:6379

# ─── Authentication ───────────────────────────────────────────────────────────
# MUST be a cryptographically random 256-bit string.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-256-bit-secret-here-generate-with-crypto-randombytes

# ─── Backend Server ───────────────────────────────────────────────────────────
PORT=3001

# ─── Frontend (Next.js public variables — exposed to browser) ─────────────────
# NEXT_PUBLIC_ prefix is required for Next.js to expose these to the client bundle
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ─── NextAuth (if used) ───────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000
